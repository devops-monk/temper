{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Temper",
  "version": "0.1.0",
  "identifier": "app.temper.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Temper",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run, fine-tune and ship local AI models",
    "longDescription": "Temper runs, fine-tunes and exports open-weight AI models on your own computer.",
    "copyright": "© 2026 Temper contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/pyproject.toml": "engine/pyproject.toml",
      "../engine/uv.lock": "engine/uv.lock",
      "../engine/temper_engine/": "engine/temper_engine/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "gguf"
        ],
        "name": "GGUF model",
        "description": "AI model",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/octet-stream"
      },
      {
        "ext": [
          "jsonl",
          "parquet"
        ],
        "name": "Training data",
        "description": "Dataset",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "temper"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQ0RCODk1QzUyNjMxMDUKUldRRk1TYkZsYmpOMGdMNDRoVndnRWdJbWRDMllHOVJSdExSdDV6dUFoNmFya3N2KzVOYlNhT1MK",
      "endpoints": [
        "https://github.com/devops-monk/temper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
